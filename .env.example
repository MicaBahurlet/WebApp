# Plantilla de entorno para el equipo.
# Copiá este archivo como .env en la raíz del proyecto y completá los valores.
# .env no se sube al repositorio.

# Host de MySQL. En local suele ser 127.0.0.1.
DB_HOST=127.0.0.1

# Puerto de MySQL.
# 3306 si en MAMP elegiste los puertos 80 y 3306.
# 8889 si dejaste los puertos por defecto de MAMP.
DB_PORT=3306

# Nombre de la base. Tiene que coincidir con database/sistema_turnos.sql.
DB_NAME=sistema_turnos

# Usuario de MySQL.
DB_USER=root

# Contraseña. Vacía para el root de Homebrew.
# En MAMP, el root inicial usa la contraseña root.
DB_PASS=



EMAIL_API_KEY='TU_API_DE_RESEND'